# Copy to .env and fill in. Create the Spotify app at
# https://developer.spotify.com/dashboard — Development Mode, redirect URI
# must exactly match SPOTIFY_REDIRECT_PORT below. No client secret is used
# (PKCE flow), so none is requested here.

SPOTIFY_CLIENT_ID=

# Must match the redirect URI registered on the Spotify app:
# http://127.0.0.1:<port>/callback
SPOTIFY_REDIRECT_PORT=8888

# --- Safety --------------------------------------------------------------

# Logs intended writes instead of sending them. Flip to false once you've
# verified previews look right.
SPOTIFY_MCP_DRY_RUN=true

# Off by default: removing items from a playlist is the one genuinely
# destructive write this server exposes. Leave false unless you want it.
SPOTIFY_MCP_ALLOW_REMOVALS=false

SPOTIFY_MCP_LOG_LEVEL=INFO

# --- Local listening-history analytics ------------------------------------

# IANA timezone name (e.g. Europe/Zagreb, America/New_York). Without this,
# hour-of-day/day-of-week analytics are bucketed in UTC, not your local time.
# Re-run `spotify-mcp ingest` after changing it.
SPOTIFY_MCP_TIMEZONE=UTC

# A play counts as "skipped" when reason_end='fwdbtn' and it played less
# than this many milliseconds — a heuristic, not ground truth (the export
# has no track duration to compute a true completion ratio). See
# docs/analytics_schema.md.
SPOTIFY_MCP_SKIP_MS_THRESHOLD=30000

# A play counts as "substantial" (not a brief skip) at or above this many ms.
SPOTIFY_MCP_SUBSTANTIAL_MS=30000

# query_listening_history (guarded free-form SQL) is cancelled if it runs
# longer than this many seconds, and capped at this many result rows.
SPOTIFY_MCP_QUERY_TIMEOUT_S=10
SPOTIFY_MCP_ANALYTICS_MAX_ROWS=5000

# --- Resolver / chart-to-playlist pipeline ---------------------------------

# Below this fraction of candidates resolving, build_playlist_from_candidates
# marks its preview low_confidence rather than presenting it as routine.
SPOTIFY_MCP_RESOLVER_MIN_RATE=0.7

# --- HTTP client tuning (defaults are fine for personal use) ---------------

# Concurrent requests in flight, and a self-imposed ceiling on calls per
# rolling 30s window — Spotify doesn't publish its actual Dev Mode limit.
SPOTIFY_MCP_MAX_CONCURRENCY=4
SPOTIFY_MCP_CALLS_PER_30S=90
SPOTIFY_MCP_MAX_RETRIES=3
SPOTIFY_MCP_REQUEST_TIMEOUT_S=15

# Conditional-GET (ETag) caching for repeated reads. Saves bandwidth/latency,
# not Spotify rate-limit quota (a 304 is still one call) — see api/cache.py.
# Turn off only to debug a caching-related discrepancy.
SPOTIFY_MCP_HTTP_CACHE_ENABLED=true
